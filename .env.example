# ==============================================================================
# Prospect Digital Analyzer - Environment Configuration Template
# ==============================================================================

# Application Settings
PROJECT_NAME="Prospect Digital Analyzer"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="prospect_analyzer_db"

# When running in Docker Compose, POSTGRES_SERVER is overridden to "db"
DATABASE_URL="postgresql+asyncpg://postgres:postgres_password@localhost:5432/prospect_analyzer_db"
DATABASE_URL_SYNC="postgresql+psycopg2://postgres:postgres_password@localhost:5432/prospect_analyzer_db"

# Redis & Celery Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# External API Integrations (Add your API keys below)
PAGESPEED_API_KEY=""
SEMRUSH_API_KEY=""
HUNTER_API_KEY=""
HUBSPOT_ACCESS_TOKEN=""

# Crawler Service Limits & Configuration (Constants)
CRAWLER_CONCURRENT_REQUESTS_PER_DOMAIN=2
CRAWLER_DELAY_BETWEEN_REQUESTS_SECONDS=1.5
CRAWLER_CONCURRENT_DOMAINS_BATCH=5
CRAWLER_MAX_PAGES_PER_SITE=20
CRAWLER_MAX_DEPTH=2
CRAWLER_REQUEST_TIMEOUT_SECONDS=10.0
CRAWLER_TOTAL_SITE_TIMEOUT_SECONDS=75.0
CRAWLER_USER_AGENT="ProspectDigitalAnalyzer/1.0 (+https://prospectanalyzer.io/bot)"
CRAWLER_MAX_RETRIES=1

# Scoring Engine Weights (Must sum to 1.0)
WEIGHT_PERFORMANCE=0.25
WEIGHT_SEO=0.25
WEIGHT_LEAD_GEN=0.25
WEIGHT_UI_UX=0.15
WEIGHT_BROKEN_LINKS=0.10

# Content Appropriateness Heuristics
CONTENT_MODERATION_ENABLED=true
